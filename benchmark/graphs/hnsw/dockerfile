FROM python:3.9-slim

# Build arguments for quantizer and graph
ARG QUANTIZER_NAME
ARG GRAPH_NAME=hnsw

# Avoid timezone prompt
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install system dependencies (minimal for hnswlib + quantizers)
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    g++ \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Eigen 3.4.0 (for quantizers like RabitQ)
RUN cd /tmp && \
    wget https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz && \
    tar -xzf eigen-3.4.0.tar.gz && \
    cd eigen-3.4.0 && \
    mkdir build && cd build && \
    cmake .. && \
    make install && \
    cd / && rm -rf /tmp/eigen-3.4.0*

# Clone hnswlib
RUN cd /opt && \
    git clone https://github.com/nmslib/hnswlib.git && \
    cd hnswlib && \
    git checkout v0.8.0

# Copy and apply the hnswlib patch
COPY benchmark/graphs/hnsw/hnswlib_custom_quantizer.patch /tmp/hnswlib_custom_quantizer.patch
RUN cd /opt/hnswlib && \
    git apply /tmp/hnswlib_custom_quantizer.patch && \
    rm /tmp/hnswlib_custom_quantizer.patch

# Install Python dependencies
RUN pip install --no-cache-dir \
    numpy \
    h5py \
    pyyaml \
    psutil \
    "pybind11[global]" \
    faiss-cpu

# Copy the benchmark framework code
COPY benchmark/ /benchmark/

# Copy the quantizer module
COPY benchmark/algorithms/quantizer/${QUANTIZER_NAME}/ /algorithms/quantizer/${QUANTIZER_NAME}/

# Copy the graph module
COPY benchmark/graphs/${GRAPH_NAME}/ /algorithms/graphs/${GRAPH_NAME}/

# Build quantizer C++ bindings if they exist
RUN if [ -f /algorithms/quantizer/${QUANTIZER_NAME}/CMakeLists.txt ]; then \
        cd /algorithms/quantizer/${QUANTIZER_NAME}/ && \
        mkdir -p build && \
        cd build && \
        cmake .. && \
        make -j$(nproc) && \
        cp *_cpp*.so .. 2>/dev/null || true && \
        cd .. && \
        rm -rf build; \
    fi

# Build hnswlib Python bindings
RUN cd /opt/hnswlib && \
    pip install .

# Set Python path to include all necessary directories
ENV PYTHONPATH=/:/opt/hnswlib:/algorithms/quantizer/${QUANTIZER_NAME}:/algorithms/graphs/${GRAPH_NAME}
ENV HNSWLIB_PATH=/opt/hnswlib

# Set working directory
WORKDIR /workspace
