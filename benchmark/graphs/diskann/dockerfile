FROM python:3.9-slim

# Build arguments for quantizer and graph
ARG QUANTIZER_NAME
ARG GRAPH_NAME=diskann

# Avoid timezone prompt
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install system dependencies for both DiskANN and common quantizers
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    g++ \
    git \
    wget \
    libaio-dev \
    libopenblas-dev \
    liblapacke-dev \
    libboost-all-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Note: Skip Intel MKL installation as it requires complex setup in Docker
# DiskANN will use OpenBLAS and LAPACKE instead

# Install Eigen 3.4.0 (for quantizers like RabitQ)
RUN cd /tmp && \
    wget https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz && \
    tar -xzf eigen-3.4.0.tar.gz && \
    cd eigen-3.4.0 && \
    mkdir build && cd build && \
    cmake .. && \
    make install && \
    cd / && rm -rf /tmp/eigen-3.4.0*

# Clone DiskANN
RUN cd /opt && \
    git clone https://github.com/microsoft/DiskANN.git

# Copy patch file first so we can test it
COPY benchmark/graphs/diskann/diskann_custom_quantizer.patch /tmp/diskann_custom_quantizer.patch

# Find the exact commit that matches the patch and apply it
# The patch file contains git object hashes: 
# - include/pq_flash_index.h: ba5258e (expected original)
# - include/boost_dynamic_bitset_fwd.h: 5aebb2b
# - src/pq_flash_index.cpp: d9ad506
RUN cd /opt/DiskANN && \
    echo "Searching for commit with matching file versions..." && \
    # Find commit where pq_flash_index.h has the exact hash expected by patch
    # We'll search through commits and check file hashes
    EXACT_COMMIT="" && \
    for commit in $(git log --all --format="%H" | head -200); do \
        git checkout $commit 2>/dev/null && \
        # Check if pq_flash_index.h matches expected hash (ba5258e)
        if [ -f "include/pq_flash_index.h" ]; then \
            FILE_HASH=$(git hash-object include/pq_flash_index.h 2>/dev/null) && \
            SHORT_HASH=$(echo "$FILE_HASH" | cut -c1-7) && \
            if [ "$SHORT_HASH" = "ba5258e" ]; then \
                echo "Found commit with matching pq_flash_index.h: $commit"; \
                EXACT_COMMIT=$commit; \
                break; \
            fi; \
        fi; \
    done && \
    if [ -n "$EXACT_COMMIT" ]; then \
        git checkout $EXACT_COMMIT && \
        echo "Using commit: $EXACT_COMMIT"; \
    else \
        echo "Warning: Could not find exact match, using first commit with required files"; \
        git checkout $(git log --all --full-history --format="%H" -- "include/boost_dynamic_bitset_fwd.h" 2>/dev/null | head -1); \
    fi && \
    # Verify required files exist
    if [ ! -f "include/boost_dynamic_bitset_fwd.h" ] || \
       [ ! -f "include/pq_flash_index.h" ] || \
       [ ! -f "src/pq_flash_index.cpp" ]; then \
        echo "ERROR: Required files for patch are missing!"; \
        exit 1; \
    fi && \
    # Apply the patch
    echo "Applying patch..." && \
    if git apply /tmp/diskann_custom_quantizer.patch 2>&1; then \
        echo "Patch applied successfully"; \
    else \
        echo "ERROR: Patch application failed"; \
        echo "Trying with --ignore-whitespace..."; \
        if ! git apply --ignore-whitespace /tmp/diskann_custom_quantizer.patch 2>&1; then \
            echo "Patch failed even with --ignore-whitespace"; \
            git apply --check /tmp/diskann_custom_quantizer.patch 2>&1 || true; \
            exit 1; \
        fi; \
    fi && \
    rm /tmp/diskann_custom_quantizer.patch

# Install Python dependencies for DiskANN and common quantizers
RUN pip install --no-cache-dir \
    numpy \
    h5py \
    pyyaml \
    psutil \
    "pybind11[global]" \
    faiss-cpu

# Copy the benchmark framework code
COPY benchmark/ /benchmark/

# Copy the quantizer module
COPY benchmark/algorithms/quantizer/${QUANTIZER_NAME}/ /algorithms/quantizer/${QUANTIZER_NAME}/

# Copy the graph module
COPY benchmark/graphs/${GRAPH_NAME}/ /algorithms/graphs/${GRAPH_NAME}/

# Build quantizer C++ bindings if they exist
RUN if [ -f /algorithms/quantizer/${QUANTIZER_NAME}/CMakeLists.txt ]; then \
        cd /algorithms/quantizer/${QUANTIZER_NAME}/ && \
        mkdir -p build && \
        cd build && \
        cmake .. && \
        make -j$(nproc) && \
        cp *_cpp*.so .. 2>/dev/null || true && \
        cd .. && \
        rm -rf build; \
    fi

# Build the DiskANN Python bindings
RUN cd /algorithms/graphs/${GRAPH_NAME}/ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc) && \
    cp diskann_cpp*.so .. && \
    cd .. && \
    rm -rf build

# Set Python path to include all necessary directories
ENV PYTHONPATH=/:/opt/DiskANN:/algorithms/quantizer/${QUANTIZER_NAME}:/algorithms/graphs/${GRAPH_NAME}
ENV DISKANN_PATH=/opt/DiskANN

# Set working directory
WORKDIR /workspace

# The entrypoint will be provided by the framework at runtime
