+/**
+ * @brief Adapter class to use Python quantizers with DiskANN
+ *
+ * This class provides a C++ interface to Python quantizer objects that implement
+ * set_query() and estimate_distance() methods.
+ */
+class QuantizerAdapter {
+private:
+    py::object quantizer;  // Python quantizer object
+    int num_points;
+    int dimension;
+
+public:
+    /**
+     * @brief Construct a new Quantizer Adapter
+     *
+     * @param quantizer_obj Python quantizer object with set_query() and estimate_distance()
+     */
+    QuantizerAdapter(py::object quantizer_obj)
+        : quantizer(quantizer_obj), num_points(0), dimension(0) {
+    }
+
+    void set_metadata(int a, int b){
+        num_points = a; dimension = b;
+    }
+
+    /**
+     * @brief Train the quantizer on data
+     *
+     * @param data Training data as numpy array (num_points, dimension)
+     */
+    void train(py::array_t<float> data) {
+        auto buf = data.request();
+        num_points = buf.shape[0];
+        dimension = buf.shape[1];
+
+        // Call Python quantizer's fit method
+        quantizer.attr("fit")(num_points, data);
+    }
+
+    /**
+     * @brief Set the current query for distance estimation
+     *
+     * This calls the Python quantizer's set_query() method to precompute
+     * distance tables for efficient distance estimation.
+     *
+     * @param query Query vector as numpy array (dimension,)
+     */
+    void set_query(py::array_t<float> query, int thread_id) {
+        quantizer.attr("set_query")(query, thread_id);
+    }
+
+    /**
+     * @brief Set the current query from raw float pointer
+     *
+     * @param query_ptr Pointer to query vector
+     * @param query_dim Dimension of query
+     */
+    void set_query(const float* query_ptr, int query_dim, int thread_id) {
+        if (query_dim != dimension) {
+            throw std::runtime_error("Query dimension mismatch");
+        }
+
+        // Create a new numpy array with proper memory layout
+        py::array_t<float> query(query_dim);
+        float* query_data = query.mutable_data();
+        std::memcpy(query_data, query_ptr, query_dim * sizeof(float));
+
+        // Call Python method while GIL is held
+        quantizer.attr("set_query")(query, thread_id);
+    }
+
+    /**
+     * @brief Estimate distance to a data point using quantization
+     *
+     * This calls the Python quantizer's estimate_distance() method.
+     * set_query() must be called before using this method.
+     *
+     * @param idx Index of the data point
+     * @return float Estimated distance
+     */
+    float estimate_distance(int idx, int thread_id) const {
+        py::object result = quantizer.attr("estimate_distance")(idx, thread_id);
+        return result.cast<float>();
+    }
+
+    /**
+     * @brief Batch estimate distances to multiple data points
+     *
+     * This method acquires the GIL only once for all distance estimations,
+     * significantly reducing GIL contention in parallel search.
+     *
+     * @param indices Array of data point indices
+     * @param n_indices Number of indices
+     * @param distances_out Output array for distances
+     */
+    void estimate_distances(const uint32_t* indices, size_t n_indices, float* distances_out, int thread_id) const {
+        for (size_t i = 0; i < n_indices; i++) {
+            distances_out[i] = estimate_distance(indices[i], thread_id);
+        }
+    }
+
+    int get_num_points() const { return num_points; }
+    int get_dimension() const { return dimension; }
+};
