FROM python:3.9-slim

# Build arguments
ARG ALGO_TYPE
ARG ALGO_NAME

# Install system dependencies including AVX-512 build tools
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    libgomp1 \
    libfmt-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone SAQ repository
RUN cd /opt && git clone https://github.com/howarlii/SAQ.git

# Apply SAQ patch:
#   1. CAQ encoder: allow num_bits==1 path (upstream gated with `> 1`, but
#      packer + DP bit allocator both require the fields).
#   2. saq_searcher.hpp + caq_estimator.hpp: fix IP search to be correct AND
#      fast, by mirroring L2's per-lane bound structure.
#
#      Upstream's L2-only comparisons (reduce_min, `>distk`, `<distk`, SIMD
#      LT-predicate) reject every block in IP mode → recall=0. The fix needs
#      a one-sided per-lane upper bound on <q, o> so the searcher can prune
#      symmetric to L2's per-lane LB on ||q-o||^2.
#
#      caq_estimator.hpp:
#        a. varsEstDist IP: per-lane Cauchy-Schwarz UB
#               UB(<q,o>)[j] = <q,c> + ||q|| * ||o-c||[j]
#           uses the existing factor_o_l2norm[] (per-vector ||o-c||) and the
#           segment query norm. Guaranteed by the inequality -- no statistical
#           assumption -- so cannot wrongly skip a true top-K.
#        b. compFastDist IP: combine the 1-bit residual estimate with <q,c>,
#           then add a RaBitQ-tight per-lane margin
#               eps * ||q|| * ||o-c||[j],   eps = 1.9 / sqrt(D-1)
#           (D = segment padded dim; matches the kConstEpsilon=1.9 the SAQ
#           encoder already uses). For high D this is ~sqrt(D) tighter than
#           Cauchy-Schwarz, so step 2 genuinely shrinks the per-lane UB and
#           step 3 lane gates can prune.
#
#      saq_searcher.hpp: drop the L2-only comparison hard-codes; reduce on
#      max for IP / min for L2; entry/lane/per-cluster gates all compare
#      curr_dist directly against distk -- no separate margin tracking, since
#      vars/fast already return per-lane UBs. Per-cluster acc-loop early
#      break is now safe for IP too (partial sum stays a valid UB until full
#      refinement completes).
COPY benchmark/algorithms/quantizer/SAQ/saq_ip.patch /tmp/saq_ip.patch
RUN cd /opt/SAQ && git apply /tmp/saq_ip.patch && rm /tmp/saq_ip.patch

# Install Python dependencies including pybind11
RUN pip install --no-cache-dir \
    numpy \
    h5py \
    pyyaml \
    psutil \
    threadpoolctl \
    pybind11 \
    faiss-cpu

# Copy the benchmark framework code
COPY benchmark/ /benchmark/

# Copy the algorithm module
COPY benchmark/algorithms/${ALGO_TYPE}/${ALGO_NAME}/ /algorithms/${ALGO_TYPE}/${ALGO_NAME}/

# Build the pybind11 module
RUN cd /algorithms/${ALGO_TYPE}/${ALGO_NAME}/ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make && \
    cp saq_cpp*.so .. && \
    cd .. && \
    rm -rf build

# Set Python path
ENV PYTHONPATH=/:/algorithms/quantizer/SAQ

# Set working directory
WORKDIR /workspace
