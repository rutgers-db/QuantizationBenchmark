FROM python:3.9-slim

# Build arguments
ARG ALGO_TYPE
ARG ALGO_NAME

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    libgomp1 \
    # libblas-dev \
    # liblapack-dev \
    liblapacke-dev \
    libarmadillo-dev \
    libglpk-dev \
    glpk-utils \
    && rm -rf /var/lib/apt/lists/*

# Clone VAQ repository
RUN cd /opt && \
    git clone https://github.com/TheDatumOrg/VAQ.git VAQ

# Copy and apply the VAQ patch for parallelization
COPY benchmark/algorithms/quantizer/VAQ/VAQ_parallelization.patch /tmp/VAQ_parallelization.patch
RUN cd /opt/VAQ && \
    git apply /tmp/VAQ_parallelization.patch && \
    rm /tmp/VAQ_parallelization.patch

# Build VAQ library
RUN cd /opt/VAQ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc)

# Install Python dependencies including pybind11
RUN pip install --no-cache-dir \
    numpy \
    h5py \
    pyyaml \
    psutil \
    pybind11

# Copy the benchmark framework code
COPY benchmark/ /benchmark/

# Copy the algorithm module
COPY benchmark/algorithms/${ALGO_TYPE}/${ALGO_NAME}/ /algorithms/${ALGO_TYPE}/${ALGO_NAME}/

# Build the Python bindings
RUN cd /algorithms/${ALGO_TYPE}/${ALGO_NAME}/ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make && \
    cp vaq_cpp*.so .. && \
    cd .. && \
    rm -rf build

# Set Python path to include the root directory, VAQ path, and algorithm directory
ENV PYTHONPATH=/:/opt/VAQ:/algorithms/quantizer/VAQ
ENV VAQ_PATH=/opt/VAQ

# Set working directory
WORKDIR /workspace

# The entrypoint will be provided by the framework at runtime
