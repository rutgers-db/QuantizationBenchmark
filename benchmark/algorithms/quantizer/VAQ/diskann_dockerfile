FROM python:3.9-slim

# Build arguments for quantizer and graph
ARG QUANTIZER_NAME=VAQ
ARG GRAPH_NAME=diskann

# Avoid timezone prompt
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install system dependencies for DiskANN and VAQ
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    g++ \
    git \
    wget \
    libaio-dev \
    libopenblas-dev \
    liblapacke-dev \
    libboost-all-dev \
    libgomp1 \
    libarmadillo-dev \
    libglpk-dev \
    glpk-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Eigen 3.4.0
RUN cd /tmp && \
    wget https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz && \
    tar -xzf eigen-3.4.0.tar.gz && \
    cd eigen-3.4.0 && \
    mkdir build && cd build && \
    cmake .. && \
    make install && \
    cd / && rm -rf /tmp/eigen-3.4.0*

# Clone DiskANN at specific commit that matches the patch
RUN cd /opt && \
    git clone https://github.com/microsoft/DiskANN.git && \
    cd DiskANN && \
    git checkout a26f824

# Copy and apply the DiskANN patch
COPY benchmark/graphs/diskann/diskann_custom_quantizer.patch /tmp/diskann_custom_quantizer.patch
RUN cd /opt/DiskANN && \
    git apply /tmp/diskann_custom_quantizer.patch && \
    rm /tmp/diskann_custom_quantizer.patch

# Clone VAQ repository
RUN cd /opt && \
    git clone https://github.com/TheDatumOrg/VAQ.git VAQ

# Copy and apply the VAQ patch for parallelization
COPY benchmark/algorithms/quantizer/VAQ/VAQ_parallelization.patch /tmp/VAQ_parallelization.patch
RUN cd /opt/VAQ && \
    git apply /tmp/VAQ_parallelization.patch && \
    rm /tmp/VAQ_parallelization.patch

# Build VAQ library
RUN cd /opt/VAQ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc)

# Install Python dependencies
RUN pip install --no-cache-dir \
    numpy \
    h5py \
    pyyaml \
    psutil \
    "pybind11[global]" \
    faiss-cpu

# Copy the benchmark framework code
COPY benchmark/ /benchmark/

# Copy the quantizer module
COPY benchmark/algorithms/quantizer/${QUANTIZER_NAME}/ /algorithms/quantizer/${QUANTIZER_NAME}/

# Copy the graph module
COPY benchmark/graphs/${GRAPH_NAME}/ /algorithms/graphs/${GRAPH_NAME}/

# Build VAQ Python bindings
RUN cd /algorithms/quantizer/${QUANTIZER_NAME}/ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc) && \
    cp vaq_cpp*.so .. && \
    cd .. && \
    rm -rf build

# Build the DiskANN Python bindings
RUN cd /algorithms/graphs/${GRAPH_NAME}/ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc) && \
    cp diskann_cpp*.so .. && \
    cd .. && \
    rm -rf build

# Set Python path to include all necessary directories
ENV PYTHONPATH=/:/opt/DiskANN:/opt/VAQ:/algorithms/quantizer/${QUANTIZER_NAME}:/algorithms/graphs/${GRAPH_NAME}
ENV DISKANN_PATH=/opt/DiskANN
ENV VAQ_PATH=/opt/VAQ

# Set working directory
WORKDIR /workspace
