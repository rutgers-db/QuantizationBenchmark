{
  "_doc": [
    "Configuration for IVFE8PQFastScan (learned PQ codebook on normalized residuals,",
    "RaBitQ-style scoring, PQ-fastscan-style register-resident uint8 LUT).",
    "Dispatched in module.py by nbit:",
    "  * nbit=8 -> C++ class IVFE8PQFastScan  (256-entry LUT, AVX512VBMI permutex2var)",
    "  * nbit=4 -> C++ class IVFE8PQFastScan4 (16-entry LUT, pshufb PQ4 fastscan)",
    "nbit=4 requires nsubvec to be even (subvecs are nibble-paired). LUT scale",
    "is computed adaptively (Faiss style) so the uint16 accumulator stays safe",
    "for any M; large M auto-trades LUT precision for accumulator headroom.",
    "",
    "`build` is a list of groups: each group is cartesian-producted independently,",
    "results are concatenated. This pairs nbit with the nsubvec values that match",
    "the same total bit budget (nbit*nsubvec), so the curves are comparable."
  ],

  "sift-128-euclidean": {
    "common": {
      "data_bytes": 4,
      "ndim": 128,
      "nthread": 16,
      "space": "l2"
    },
    "build": [
      { "nlist": [1024], "nbit": 8, "nsubvec": [16, 32, 64] },
      { "nlist": [1024], "nbit": 4, "nsubvec": [16, 32, 64, 128] }
    ],
    "search": [
      { "topk": 100, "nprobe": [10, 20, 30, 50, 75, 100] }
    ]
  },

  "gist-960-euclidean": {
    "common": {
      "data_bytes": 4,
      "ndim": 960,
      "nthread": 16,
      "space": "l2"
    },
    "build": [
      { "nlist": [1024], "nbit": 8, "nsubvec": [120, 240, 480] },
      { "nlist": [1024], "nbit": 4, "nsubvec": [240, 480, 960] }
    ],
    "search": [
      { "topk": 100, "nprobe": [10, 20, 30, 50, 75, 100] }
    ]
  },

  "audio-128-euclidean": {
    "common": {
      "data_bytes": 4,
      "ndim": 128,
      "nthread": 16,
      "space": "l2"
    },
    "build": [
      { "nlist": [1024, 4096], "nbit": 8, "nsubvec": [16, 64] },
      { "nlist": [1024, 4096], "nbit": 4, "nsubvec": [32, 128] }
    ],
    "search": [
      { "topk": 100, "nprobe": [10, 20, 30, 50, 75, 100], "nrerank": [200, 300, 500, 1000] }
    ]
  },

  "video-1024-euclidean": {
    "common": {
      "data_bytes": 4,
      "ndim": 1024,
      "nthread": 16,
