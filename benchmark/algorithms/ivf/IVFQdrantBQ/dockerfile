FROM python:3.9-slim

ARG ALGO_TYPE
ARG ALGO_NAME

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    numpy \
    h5py \
    pyyaml \
    psutil \
    pybind11 \
    threadpoolctl \
    faiss-cpu

COPY benchmark/ /benchmark/
COPY benchmark/algorithms/${ALGO_TYPE}/${ALGO_NAME}/ /algorithms/${ALGO_TYPE}/${ALGO_NAME}/
# The IVF wrapper compiles BinaryQuantizer.{h,cpp} from the sibling
# QdrantBinaryQuantization directory; copy them next to the wrapper so the
# CMakeLists local-path branch picks them up.
COPY benchmark/algorithms/quantizer/QdrantBinaryQuantization/BinaryQuantizer.h \
     benchmark/algorithms/quantizer/QdrantBinaryQuantization/BinaryQuantizer.cpp \
     /algorithms/${ALGO_TYPE}/${ALGO_NAME}/

RUN cd /algorithms/${ALGO_TYPE}/${ALGO_NAME}/ && \
    mkdir -p build && cd build && \
    cmake .. && \
    make -j"$(nproc)" ivf_bq_cpp && \
    cp ivf_bq_cpp*.so .. && \
    cd .. && rm -rf build

ENV PYTHONPATH=/:/algorithms/ivf/IVFQdrantBQ
WORKDIR /workspace
