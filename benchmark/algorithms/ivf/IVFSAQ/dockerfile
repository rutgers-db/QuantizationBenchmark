FROM python:3.9-slim

# Build arguments
ARG ALGO_TYPE
ARG ALGO_NAME

# Install system dependencies including AVX-512 build tools
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    libgomp1 \
    libfmt-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone SAQ repository
RUN cd /opt && git clone https://github.com/howarlii/SAQ.git

# Apply SAQ patch:
#   1. CAQ encoder: allow num_bits==1 path (upstream gated with `> 1`, but
#      packer + DP bit allocator both require the fields).
#   2. saq_searcher.hpp: fix IP fast-path. Upstream's reduce/>distk/<distk/>=distk
#      comparisons and SIMD LT-predicate are L2-only ("smaller is better"). With
#      kDistType=IP and initial distk=-max_float, every block is rejected → KNN
#      pool stays default-zeroed → recall=0. Even after flipping directions, the
#      IP "fast-distance" estimate is a noisy estimate of accurate IP (not a
#      one-sided bound), so once distk rises, noise wrongly rejects good
#      candidates and search halts after ~200 inserts. L2 stays correct because
#      its var-prune bound makes the fast estimate conservative; IP has no
#      equivalent margin. Patch dispatches comparisons on kDistType AND for IP
#      skips the fast-distance gate entirely (process every lane through
#      compAccurateDist; slower but correct). Also disables the partial-sum
#      early break in the multi-segment accumulation loop for IP (running IP
#      isn't monotone like running L2).
COPY benchmark/algorithms/ivf/IVFSAQ/saq_ip.patch /tmp/saq_ip.patch
RUN cd /opt/SAQ && git apply /tmp/saq_ip.patch && rm /tmp/saq_ip.patch

# Install Python dependencies including pybind11
RUN pip install --no-cache-dir \
    numpy \
    h5py \
    pyyaml \
    psutil \
    threadpoolctl \
    pybind11 \
    faiss-cpu

# Copy the benchmark framework code
COPY benchmark/ /benchmark/

# Copy the algorithm module
COPY benchmark/algorithms/${ALGO_TYPE}/${ALGO_NAME}/ /algorithms/${ALGO_TYPE}/${ALGO_NAME}/

# Build the pybind11 module
RUN cd /algorithms/${ALGO_TYPE}/${ALGO_NAME}/ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make && \
    cp saq_cpp*.so .. && \
    cd .. && \
    rm -rf build

# Set Python path
ENV PYTHONPATH=/:/algorithms/${ALGO_TYPE}/${ALGO_NAME}

# Set working directory
WORKDIR /workspace
