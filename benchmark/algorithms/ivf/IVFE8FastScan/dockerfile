FROM python:3.9-slim

# Build arguments (provided by the benchmark harness)
ARG ALGO_TYPE
ARG ALGO_NAME

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Eigen 3.4.0
RUN cd /tmp && \
    wget https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz && \
    tar -xzf eigen-3.4.0.tar.gz && \
    cd eigen-3.4.0 && \
    mkdir build && cd build && \
    cmake .. && \
    make install && \
    cd / && rm -rf /tmp/eigen-3.4.0*

# Install Python dependencies including pybind11
RUN pip install --no-cache-dir \
    numpy \
    h5py \
    pyyaml \
    psutil \
    pybind11 \
    threadpoolctl \
    faiss-cpu

# Copy the benchmark framework code
COPY benchmark/ /benchmark/

# IVFE8FastScan shares the same C++ source as IVFE8.
# Copy the IVFE8 source tree into this algorithm's working directory,
# then overlay the FastScan-specific module.py.
COPY benchmark/algorithms/ivf/IVFE8/ /algorithms/ivf/IVFE8FastScan/
COPY benchmark/algorithms/ivf/IVFE8FastScan/module.py /algorithms/ivf/IVFE8FastScan/module.py
COPY benchmark/algorithms/ivf/IVFE8FastScan/config.yaml /algorithms/ivf/IVFE8FastScan/config.yaml

# Build the Python bindings (produces e8_cpp.so containing both IVFE8 and IVFE8FastScan)
RUN cd /algorithms/ivf/IVFE8FastScan/ && \
    mkdir -p build && \
    cd build && \
    cmake .. && \
    make && \
    cp e8_cpp*.so .. && \
    cd .. && \
    rm -rf build

# Set Python path
ENV PYTHONPATH=/:/algorithms/ivf/IVFE8FastScan

# Set working directory
WORKDIR /workspace
